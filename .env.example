# Example environment file for local development (Neon PostgreSQL)
# Copy this to .env and replace the placeholder with your actual Neon connection string.
# The connection string should include the pgvector extension (Neon supports it).
# Example: postgres://user:password@<project>.neon.tech:5432/<database>

DATABASE_URL=postgresql://username:password@your-neon-project.neon.tech:5432/nova

# Gemini chat configuration. Free-tier usage is subject to Google's quotas and terms.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash

# Redis URL used by the API to enqueue document jobs and by the Celery worker.
# Docker Compose overrides this to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# Local private file storage is the default and needs no S3 account.
# Docker Compose stores files in its persistent document_files volume.
FILE_STORAGE_BACKEND=local
# Local mode processes jobs in the API background without Redis.
RAG_TASK_MODE=background
# Outside Docker, defaults to backend/local_storage.
# LOCAL_STORAGE_PATH=E:\AI\assessment\novaAi\backend\local_storage

# Optional S3-compatible storage for later deployment:
# FILE_STORAGE_BACKEND=s3
# S3_BUCKET=your-private-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=your-storage-access-key
# AWS_SECRET_ACCESS_KEY=your-storage-secret-key
# Optional upload limit override, in bytes (default 15 MiB).
# MAX_DOCUMENT_UPLOAD_BYTES=15728640
